__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
*.egg-info/
output/
output_*/
# pytest transient temp roots from CLI/runtime contract suites (large, not evidence)
.pytest-tmp/
.pytest-tmp-*/
# Canary workspaces under novels/tier0-*-canary/ are pinned production
# evidence: their output/artifacts are force-added despite the output/ rule
# above. Git still tracks them once staged. Do not delete the force-added
# audit/extend/compose canary artifacts in docs/00_project/releases/.
*.bak
.claude/settings.local.json
.claude/settings.json
.arts/
.codeartsdoer/
input_short.txt
input.txt
.ai-memory/
.taskflow/
# 具体小说信息（标题/正文/工作区/证据源）一律不入 GitHub——GitHub 仅保留工具框架与风格库积累
novels/*/
!novels/tier0-*-canary/
# 真实小说 canary 输入（章节正文/证据源）不入库；仅保留 tier0 合成样本
canary_inputs/*
!canary_inputs/tier0_*
# 本地私密备份（小说正文/证据源），仅存本机
.private_backup/
